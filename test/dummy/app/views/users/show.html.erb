<div class="flex w-full max-w-md flex-col gap-4 text-sm">
  <p class="text-foreground-intense font-medium">The controller received</p>
  <pre class="bg-background-subtle border-border-muted overflow-x-auto rounded-lg border p-4 font-mono text-xs"><%= JSON.pretty_generate(@submitted_params.to_h) %></pre>
  <p><code>User.new(user_params).save</code> → <strong class="text-success-emphasis"><%= @user.persisted? %></strong></p>
  <p class="text-foreground-intense font-medium">Saved User #<%= @user.id %></p>
  <pre class="bg-background-subtle border-border-muted overflow-x-auto rounded-lg border p-4 font-mono text-xs"><%= JSON.pretty_generate(@user.as_json(except: %i[ created_at updated_at ], include: { address: { only: %i[ city country ] }, phones: { only: %i[ number kind ] } })) %></pre>
  <%= link_to "Back to the form", new_user_path, class: "underline" %>
</div>
