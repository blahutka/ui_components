source "https://rubygems.org"

# Specify your gem's dependencies in ui_components.gemspec.
gemspec

gem "puma"
gem "propshaft"
gem "tailwindcss-rails", "~> 4.2"
gem "lookbook", ">= 2.3"
# Evented file watching: Lookbook live-refreshes the browser when previews, pages or components change
gem "listen", ">= 3.9"
# Number formats, month names etc. for the locales the Lookbook locale switch offers
gem "rails-i18n", "~> 8.0"

# Omakase Ruby styling [https://github.com/rails/rubocop-rails-omakase/]
gem "rubocop-rails-omakase", require: false
